// # oochmod Main Entry Point
//
// Logline: Sovereign permission manager with declarative systemd-tmpfiles synthesis and MCP stdio server.
//
// Setup: Demands explicit capability tokens FsReadCap, ProcessCap, EnvCap.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Plan permission transitions or synthesize declarative systemd-tmpfiles rules.
//   3. Execute bounded mode updates or render dry-run previews under ProcessCap.
//   4. Deliver POSIX diagnostics or structured JSON telemetry.

import "core/chmod_types.oo";
import "core/chmod_calc.oo";
import "core/chmod_plan.oo";
import "core/chmod_demo.oo";
import "render/chmod_theme.oo";
import "ipc/chmod_opts.oo";
import "ipc/mcp_serve.oo";

pub fn render_help() -> String {
    return "oochmod 0.2.0 (openOODA sovereign files & navigation)\n"
        + "usage: oochmod [OPTION]... MODE[,MODE]... FILE...\n"
        + "  or:  oochmod [OPTION]... OCTAL-MODE FILE...\n"
        + "  or:  oochmod [OPTION]... --reference=RFILE FILE...\n\n"
        + "Change the mode of each FILE to MODE.\n\n"
        + "Options:\n"
        + "  -c, --changes          like verbose but report only when a change is made\n"
        + "  -f, --silent, --quiet  suppress most error messages\n"
        + "  -v, --verbose          output a diagnostic for every file processed\n"
        + "  -R, --recursive        change files and directories recursively\n"
        + "      --reference=RFILE  use RFILE's mode rather than MODE values\n"
        + "      --dry-run          simulate permission changes without disk writes\n"
        + "      --tmpfiles         synthesize declarative systemd-tmpfiles rules\n"
        + "      --demo             run demonstration scenarios with synthetic fixtures\n"
        + "      --json             output formatted as JSON Lines\n"
        + "  -h, --help             display this help and exit\n"
        + "  -V, --version          output version information and exit\n"
        + "      --mcp              run as Model Context Protocol stdio server\n";
}

pub fn render_version() -> String {
    return "oochmod 0.2.0 (openOODA sovereign files & navigation)\n";
}

pub fn main(
    fs: &FsReadCap,
    proc_cap: &ProcessCap,
    _env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: ChmodOpts = parse_chmod_opts(args);

    if opts.help_mode {
        print(render_help());
        return Ok(0);
    }
    if opts.version_mode {
        print(render_version());
        return Ok(0);
    }
    if opts.mcp_mode {
        run_mcp_server(fs, proc_cap);
        return Ok(0);
    }

    if opts.demo_mode {
        let demo_targets: List[ChmodTarget] = build_demo_targets();
        let demo_sum: ChmodSummary = build_demo_summary();

        if opts.tmpfiles_mode {
            let tmp_rules: List[TmpfilesEntry] = build_demo_tmpfiles();
            print(format_tmpfiles_config(tmp_rules));
            return Ok(0);
        }

        if opts.json_mode {
            print(render_json_results(demo_targets, demo_sum, "0755"));
            return Ok(0);
        }

        let n: Int = list_len(demo_targets);
        let mut i: Int = 0;
        while i < n {
            let t: ChmodTarget = list_get(demo_targets, i);
            print(render_target_output(t, true, opts.changes_only, opts.quiet));
            i = i + 1;
        }
        return Ok(0);
    }

    let mut target_mode_spec: String = opts.mode;

    if chars_len(opts.reference) > 0 {
        let ref_mode: Int = inspect_path_mode(proc_cap, opts.reference);
        target_mode_spec = int_to_octal_str(ref_mode);
    }

    let num_files: Int = list_len(opts.files);
    if chars_len(target_mode_spec) == 0 || num_files == 0 {
        print(render_help());
        return Ok(1);
    }

    let mut planned_targets: List[ChmodTarget] = list_new();
    let mut i: Int = 0;
    while i < num_files {
        let fpath: String = list_get(opts.files, i);
        let curr_val: Int = inspect_path_mode(proc_cap, fpath);
        let planned: ChmodTarget = plan_single_chmod(fpath, curr_val, target_mode_spec);
        planned_targets = list_push(planned_targets, planned);
        i = i + 1;
    }

    if opts.tmpfiles_mode {
        let tmpfiles_entries: List[TmpfilesEntry] = build_chmod_tmpfiles(planned_targets, opts.recursive);
        print(format_tmpfiles_config(tmpfiles_entries));
        return Ok(0);
    }

    let executed_targets: List[ChmodTarget] = execute_chmod_plan(proc_cap, planned_targets, opts.recursive, opts.dry_run);
    let sum: ChmodSummary = summarize_chmod_targets(executed_targets);

    if opts.json_mode {
        print(render_json_results(executed_targets, sum, target_mode_spec));
        if sum.failed > 0 {
            return Ok(1);
        }
        return Ok(0);
    }

    let n: Int = list_len(executed_targets);
    let mut idx: Int = 0;
    while idx < n {
        let t: ChmodTarget = list_get(executed_targets, idx);
        print(render_target_output(t, opts.verbose, opts.changes_only, opts.quiet));
        idx = idx + 1;
    }

    print(render_summary_warnings(sum));

    if sum.failed > 0 {
        return Ok(1);
    }
    return Ok(0);
}
