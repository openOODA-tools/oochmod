// # oochmod Planning and Execution Engine
//
// Logline: Plans filesystem permission changes, synthesizes systemd-tmpfiles rules, and executes updates.
//
// Setup: Inspects path metadata under ProcessCap and maps declarative mode transitions.
//
// Beats:
//   1. Inspect filesystem path mode attributes via ProcessCap.
//   2. Formulate declarative change plans and detect retained configurations.
//   3. Synthesize systemd-tmpfiles declarative state specifications.
//   4. Apply changes or generate dry-run preview records.

import "core/chmod_types.oo";
import "core/chmod_calc.oo";
import "std/fs/process/process.oo";

pub fn inspect_path_mode(proc_cap: &ProcessCap, path: String) -> Int {
    let cmd: String = "stat -c '%a' " + path;
    let res: Result[String, String] = process_exec(proc_cap, cmd);
    if res.is_ok() {
        let out: String = match res { Ok(s) => s, Err(_) => "" };
        return octal_to_int(str_trim(out));
    }
    return 420;
}

pub fn plan_single_chmod(
    path: String,
    curr_mode: Int,
    mode_spec: String
) -> ChmodTarget {
    let tgt_mode: Int = resolve_target_mode(curr_mode, mode_spec);
    let curr_oct: String = int_to_octal_str(curr_mode);
    let curr_sym: String = mode_to_symbolic(curr_mode);
    let tgt_oct: String = int_to_octal_str(tgt_mode);
    let tgt_sym: String = mode_to_symbolic(tgt_mode);

    if curr_mode == tgt_mode {
        return make_chmod_target(path, curr_oct, curr_sym, tgt_oct, tgt_sym, "RETAINED", "");
    }
    return make_chmod_target(path, curr_oct, curr_sym, tgt_oct, tgt_sym, "PENDING", "");
}

pub fn summarize_chmod_targets(targets: List[ChmodTarget]) -> ChmodSummary {
    let n: Int = list_len(targets);
    let mut changed_count: Int = 0;
    let mut retained_count: Int = 0;
    let mut failed_count: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let t: ChmodTarget = list_get(targets, i);
        if t.status == "CHANGED" || t.status == "WOULD_CHANGE" {
            changed_count = changed_count + 1;
        } else if t.status == "RETAINED" {
            retained_count = retained_count + 1;
        } else if t.status == "FAILED" {
            failed_count = failed_count + 1;
        }
        i = i + 1;
    }
    return make_chmod_summary(n, changed_count, retained_count, failed_count);
}

pub fn build_chmod_tmpfiles(targets: List[ChmodTarget], recursive: Bool) -> List[TmpfilesEntry] {
    let mut entries: List[TmpfilesEntry] = list_new();
    let n: Int = list_len(targets);
    let act: String = if recursive { "Z" } else { "z" };
    let mut i: Int = 0;

    while i < n {
        let t: ChmodTarget = list_get(targets, i);
        let entry: TmpfilesEntry = make_tmpfiles_entry(act, t.path, t.target_mode_octal, "-", "-");
        entries = list_push(entries, entry);
        i = i + 1;
    }
    return entries;
}

pub fn format_tmpfiles_rule(entry: TmpfilesEntry) -> String {
    return entry.action + " " + entry.path + " " + entry.mode + " "
        + entry.uid + " " + entry.gid + " " + entry.age + " " + entry.argument;
}

pub fn format_tmpfiles_config(entries: List[TmpfilesEntry]) -> String {
    let mut out: String = "# /etc/tmpfiles.d/oochmod.conf - declarative permission rules\n"
        + "# Type Path Mode UID GID Age Argument\n";
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let e: TmpfilesEntry = list_get(entries, i);
        out = out + format_tmpfiles_rule(e) + "\n";
        i = i + 1;
    }
    return out;
}

pub fn execute_chmod_plan(
    proc_cap: &ProcessCap,
    targets: List[ChmodTarget],
    recursive: Bool,
    dry_run: Bool
) -> List[ChmodTarget] {
    let mut executed: List[ChmodTarget] = list_new();
    let n: Int = list_len(targets);
    let mut i: Int = 0;

    while i < n {
        let t: ChmodTarget = list_get(targets, i);
        if t.status == "RETAINED" {
            executed = list_push(executed, t);
        } else if dry_run {
            let updated: ChmodTarget = make_chmod_target(
                t.path,
                t.current_mode_octal,
                t.current_mode_symbolic,
                t.target_mode_octal,
                t.target_mode_symbolic,
                "WOULD_CHANGE",
                ""
            );
            executed = list_push(executed, updated);
        } else {
            let flag: String = if recursive { "-R " } else { "" };
            let cmd: String = "chmod " + flag + t.target_mode_octal + " " + t.path;
            let res: Result[String, String] = process_exec(proc_cap, cmd);
            if res.is_ok() {
                let updated: ChmodTarget = make_chmod_target(
                    t.path,
                    t.current_mode_octal,
                    t.current_mode_symbolic,
                    t.target_mode_octal,
                    t.target_mode_symbolic,
                    "CHANGED",
                    ""
                );
                executed = list_push(executed, updated);
            } else {
                let updated: ChmodTarget = make_chmod_target(
                    t.path,
                    t.current_mode_octal,
                    t.current_mode_symbolic,
                    t.target_mode_octal,
                    t.target_mode_symbolic,
                    "FAILED",
                    "operation failed or permission denied"
                );
                executed = list_push(executed, updated);
            }
        }
        i = i + 1;
    }
    return executed;
}
